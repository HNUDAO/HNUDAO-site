---
import ActivityCard from "@/components/ActivityCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Tag from "@/components/Tag.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { getEntryHref, isExternalHref, isPublished, sortEntriesByDate, filterByLocale } from "@/lib/content";
import { getCollection } from "astro:content";
import { getLocaleFromPath, useTranslations } from "@/lib/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const entries = sortEntriesByDate(filterByLocale(await getCollection("activities"), locale).filter(isPublished), "startDate");
const featured = entries.find((entry) => entry.data.featured);
const statusLabels = [
  { label: "upcoming", text: t("activities.upcoming") },
  { label: "ongoing", text: t("activities.ongoing") },
  { label: "past", text: t("activities.past") },
];
const featuredHref = featured ? getEntryHref(featured) : "#";
const featuredExternal = isExternalHref(featuredHref);
---

<ContentLayout
  breadcrumbs={[{ label: t("activities.breadcrumb") }]}
  description={t("activities.description")}
  eyebrow={t("labels.activities")}
  title={t("activities.title")}
>
  <section class="section-shell pt-0">
    <div class="page-shell grid gap-5 lg:grid-cols-[1.06fr_0.94fr]">
      {featured && (
        <div class="surface-card overflow-hidden">
          <img
            alt={`${featured.data.title} cover`}
            class="aspect-[16/8] w-full object-cover"
            height="480"
            src={featured.data.cover || "/images/placeholder-cover.svg"}
            width="960"
            decoding="async"
          />
          <div class="px-5 py-7 sm:px-7 sm:py-8">
            <p class="subtle-label">{t("labels.featuredActivity")}</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950">{featured.data.title}</h2>
            <p class="mt-4 text-base leading-8 text-ink-600">{featured.data.description}</p>
            <a
              class="glass-button focus-ring mt-8 inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold text-ink-900 transition hover:text-signal-500"
              href={featuredHref}
              rel={featuredExternal ? "noreferrer" : undefined}
              target={featuredExternal ? "_blank" : undefined}
            >
              {t("common.viewLink")}
            </a>
          </div>
        </div>
      )}

      <div class="surface-card px-5 py-7 sm:px-7 sm:py-8">
        <SectionHeading
          eyebrow={t("labels.status")}
          title={t("activities.statusTitle")}
          description={t("activities.statusDesc")}
        />
        <div class="flex flex-wrap gap-3">
          {statusLabels.map((status) => <Tag label={`${status.label} / ${status.text}`} variant="accent" />)}
        </div>
        <div class="mt-6 grid gap-3">
          <div class="glass-tile px-4 py-4">
            <p class="text-sm font-semibold text-ink-950">{t("activities.maintainMethod")}</p>
            <p class="mt-2.5 text-sm leading-6 text-ink-600">
              {t("activities.maintainMethodDesc")}
            </p>
          </div>
          <div class="glass-tile px-4 py-4">
            <p class="text-sm font-semibold text-ink-950">{t("activities.currentNote")}</p>
            <p class="mt-2.5 text-sm leading-6 text-ink-600">
              {t("activities.currentNoteDesc")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pt-0">
    <div class="page-shell">
      <SectionHeading
        eyebrow={t("labels.allActivities")}
        title={t("activities.allActivitiesTitle")}
        description={t("activities.allActivitiesDesc")}
      />
      <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
        {entries.map((entry) => (
          <ActivityCard
            category={entry.data.category}
            cover={entry.data.cover}
            description={entry.data.description}
            href={getEntryHref(entry)}
            location={entry.data.location}
            startDate={entry.data.startDate}
            status={entry.data.status}
            tags={entry.data.tags}
            title={entry.data.title}
          />
        ))}
      </div>
    </div>
  </section>
</ContentLayout>
