---
import CTASection from "@/components/CTASection.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import StatCard from "@/components/StatCard.astro";
import Timeline from "@/components/Timeline.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { timelineItems } from "@/data/timeline";
import { getLocaleFromPath, useTranslations } from "@/lib/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<ContentLayout
  breadcrumbs={[{ label: t("about.breadcrumb") }]}
  description={t("about.description")}
  eyebrow={t("labels.about")}
  title={t("about.title")}
>
  <section class="section-shell pt-0">
    <div class="page-shell grid gap-10 xl:grid-cols-[1.1fr_0.9fr]">
      <div class="surface-card px-6 py-8 sm:px-8">
        <SectionHeading
          eyebrow={t("labels.introduction")}
          title={t("about.introTitle")}
          description={t("about.introDesc")}
        />
        <div class="grid gap-5 md:grid-cols-2">
          <div class="rounded-3xl border border-ink-100 bg-ink-50 px-5 py-5">
            <h3 class="text-xl font-semibold text-ink-950">{t("about.vision")}</h3>
            <p class="mt-3 text-base leading-8 text-ink-600">{t("about.visionDesc")}</p>
          </div>
          <div class="rounded-3xl border border-ink-100 bg-ink-50 px-5 py-5">
            <h3 class="text-xl font-semibold text-ink-950">{t("about.mission")}</h3>
            <p class="mt-3 text-base leading-8 text-ink-600">{t("about.missionDesc")}</p>
          </div>
        </div>
      </div>
      <div class="grid gap-4 sm:grid-cols-3 xl:grid-cols-1">
        <StatCard label={t("about.memberScale")} note={t("about.memberScaleNote")} value={t("about.memberScaleValue")} />
        <StatCard label={t("about.activityPlan")} note={t("about.activityPlanNote")} value={t("about.activityPlanValue")} />
        <StatCard label={t("about.projectDirection")} note={t("about.projectDirectionNote")} value={t("about.projectDirectionValue")} />
      </div>
    </div>
  </section>

  <section class="section-shell bg-white/65">
    <div class="page-shell">
      <SectionHeading
        eyebrow={t("labels.culture")}
        title={t("about.cultureTitle")}
        description={t("about.cultureDesc")}
      />
      <div class="grid gap-5 lg:grid-cols-3">
        <article class="surface-card px-6 py-7">
          <h3 class="text-2xl font-semibold text-ink-950">{t("about.openCollab")}</h3>
          <p class="mt-4 text-base leading-8 text-ink-600">{t("about.openCollabDesc")}</p>
        </article>
        <article class="surface-card px-6 py-7">
          <h3 class="text-2xl font-semibold text-ink-950">{t("about.techPractice")}</h3>
          <p class="mt-4 text-base leading-8 text-ink-600">{t("about.techPracticeDesc")}</p>
        </article>
        <article class="surface-card px-6 py-7">
          <h3 class="text-2xl font-semibold text-ink-950">{t("about.longTerm")}</h3>
          <p class="mt-4 text-base leading-8 text-ink-600">{t("about.longTermDesc")}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="page-shell grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="surface-card px-6 py-8 sm:px-8">
        <SectionHeading
          eyebrow={t("labels.future")}
          title={t("about.futureTitle")}
          description={t("about.futureDesc")}
        />
        <ul class="space-y-3 text-base leading-8 text-ink-600">
          <li>{t("about.futureItem1")}</li>
          <li>{t("about.futureItem2")}</li>
          <li>{t("about.futureItem3")}</li>
        </ul>
      </div>
      <div class="surface-card px-6 py-8 sm:px-8">
        <SectionHeading
          eyebrow={t("labels.timeline")}
          title={t("about.timelineTitle")}
          description={t("about.timelineDesc")}
        />
        <Timeline items={timelineItems[locale]} />
      </div>
    </div>
  </section>

  <section class="section-shell pt-0">
    <div class="page-shell">
      <CTASection
        description={t("about.ctaDesc")}
          eyebrow={t("labels.nextStep")}
        primaryHref="/join"
        primaryLabel={t("about.learnJoin")}
        secondaryHref="/contact"
        secondaryLabel={t("home.contactUs")}
        title={t("about.ctaTitle")}
      />
    </div>
  </section>
</ContentLayout>
