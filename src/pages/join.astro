---
import CTASection from "@/components/CTASection.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { getLocaleFromPath, useTranslations } from "@/lib/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
---

<ContentLayout
  breadcrumbs={[{ label: t("join.breadcrumb") }]}
  description={t("join.description")}
  eyebrow={t("labels.join")}
  title={t("join.title")}
>
  <section class="section-shell pt-0">
    <div class="page-shell grid gap-5 lg:grid-cols-3">
      <article class="surface-card px-6 py-7">
        <h2 class="text-2xl font-semibold text-ink-950">{t("join.whyJoin")}</h2>
        <p class="mt-4 text-base leading-8 text-ink-600">{t("join.whyJoinDesc")}</p>
      </article>
      <article class="surface-card px-6 py-7">
        <h2 class="text-2xl font-semibold text-ink-950">{t("join.whoFits")}</h2>
        <p class="mt-4 text-base leading-8 text-ink-600">{t("join.whoFitsDesc")}</p>
      </article>
      <article class="surface-card px-6 py-7">
        <h2 class="text-2xl font-semibold text-ink-950">{t("join.deptAdvice")}</h2>
        <p class="mt-4 text-base leading-8 text-ink-600">{t("join.deptAdviceDesc")}</p>
      </article>
    </div>
  </section>

  <section class="section-shell bg-white/65">
    <div class="page-shell">
      <SectionHeading
        eyebrow={t("labels.process")}
        title={t("join.processTitle")}
        description={t("join.processDesc")}
      />
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        <article class="surface-card px-5 py-6">
          <p class="subtle-label">Step 01</p>
          <h3 class="mt-3 text-xl font-semibold text-ink-950">{t("join.step1Title")}</h3>
          <p class="mt-3 text-sm leading-7 text-ink-600">{t("join.step1Desc")}</p>
        </article>
        <article class="surface-card px-5 py-6">
          <p class="subtle-label">Step 02</p>
          <h3 class="mt-3 text-xl font-semibold text-ink-950">{t("join.step2Title")}</h3>
          <p class="mt-3 text-sm leading-7 text-ink-600">{t("join.step2Desc")}</p>
        </article>
        <article class="surface-card px-5 py-6">
          <p class="subtle-label">Step 03</p>
          <h3 class="mt-3 text-xl font-semibold text-ink-950">{t("join.step3Title")}</h3>
          <p class="mt-3 text-sm leading-7 text-ink-600">{t("join.step3Desc")}</p>
        </article>
        <article class="surface-card px-5 py-6">
          <p class="subtle-label">Step 04</p>
          <h3 class="mt-3 text-xl font-semibold text-ink-950">{t("join.step4Title")}</h3>
          <p class="mt-3 text-sm leading-7 text-ink-600">{t("join.step4Desc")}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-shell">
    <div class="page-shell grid gap-10 lg:grid-cols-[1fr_0.9fr]">
      <div class="surface-card px-6 py-8 sm:px-8">
        <SectionHeading
          eyebrow={t("labels.faq")}
          title={t("join.faqTitle")}
          description={t("join.faqDesc")}
        />
        <div class="space-y-4">
          <details class="rounded-3xl border border-ink-100 bg-ink-50 px-5 py-4">
            <summary class="cursor-pointer text-base font-semibold text-ink-900">{t("join.faq1Q")}</summary>
            <p class="mt-3 text-sm leading-7 text-ink-600">{t("join.faq1A")}</p>
          </details>
          <details class="rounded-3xl border border-ink-100 bg-ink-50 px-5 py-4">
            <summary class="cursor-pointer text-base font-semibold text-ink-900">{t("join.faq2Q")}</summary>
            <p class="mt-3 text-sm leading-7 text-ink-600">{t("join.faq2A")}</p>
          </details>
          <details class="rounded-3xl border border-ink-100 bg-ink-50 px-5 py-4">
            <summary class="cursor-pointer text-base font-semibold text-ink-900">{t("join.faq3Q")}</summary>
            <p class="mt-3 text-sm leading-7 text-ink-600">{t("join.faq3A")}</p>
          </details>
        </div>
      </div>

      <div class="surface-card-dark px-6 py-8 sm:px-8">
        <p class="cta-eyebrow text-xs font-semibold">{t("labels.registration")}</p>
        <h2 class="cta-title mt-3 text-3xl">{t("join.registerTitle")}</h2>
        <p class="cta-description mt-4 text-base leading-8">
          {t("join.registerDesc")}
        </p>
        <a
          class="focus-ring cta-primary-button mt-8 inline-flex items-center justify-center rounded-full px-6 py-3 text-sm font-semibold transition hover:-translate-y-0.5"
          href="#"
        >
          {t("join.registerBtn")}
        </a>
        <div class="cta-note-panel mt-8 rounded-3xl px-5 py-5 text-sm leading-7 text-white/76">
          {t("join.registerNote")}
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pt-0">
    <div class="page-shell">
      <CTASection
        description={t("join.ctaDesc")}
        eyebrow={t("labels.keepInTouch")}
        primaryHref="/contact"
        primaryLabel={t("join.viewContact")}
        secondaryHref="/news"
        secondaryLabel={t("join.viewNews")}
        title={t("join.ctaTitle")}
      />
    </div>
  </section>
</ContentLayout>
