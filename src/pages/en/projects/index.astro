---
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Tag from "@/components/Tag.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { getEntryHref, isExternalHref, isPublished, sortEntriesByDate, filterByLocale } from "@/lib/content";
import { getCollection } from "astro:content";
import { useTranslations } from "@/lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);

const entries = sortEntriesByDate(filterByLocale(await getCollection("projects"), locale).filter(isPublished), "date");
const featured = entries.find((entry) => entry.data.featured);
const statusTags = ["planning", "active", "archived"];
const featuredHref = featured ? getEntryHref(featured) : "#";
const featuredExternal = isExternalHref(featuredHref);
---

<ContentLayout
  breadcrumbs={[{ label: t("projects.breadcrumb") }]}
  description={t("projects.description")}
  eyebrow={t("labels.projects")}
  title={t("projects.title")}
>
  <section class="section-shell pt-0">
    <div class="page-shell grid gap-5 lg:grid-cols-[1.02fr_0.98fr]">
      {featured && (
        <div class="surface-card overflow-hidden">
          <img
            alt={`${featured.data.title} cover`}
            class="aspect-[16/8] w-full object-cover"
            height="480"
            src={featured.data.cover || "/images/placeholder-cover.svg"}
            width="960"
            decoding="async"
          />
          <div class="px-5 py-7 sm:px-7 sm:py-8">
            <p class="subtle-label">{t("labels.featuredProject")}</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950">{featured.data.title}</h2>
            <p class="mt-4 text-base leading-8 text-ink-600">{featured.data.description}</p>
            <a
              class="glass-button focus-ring mt-8 inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold text-ink-900 transition hover:text-signal-500"
              href={featuredHref}
              rel={featuredExternal ? "noreferrer" : undefined}
              target={featuredExternal ? "_blank" : undefined}
            >
              {t("common.openProject")}
            </a>
          </div>
        </div>
      )}

      <div class="surface-card px-5 py-7 sm:px-7 sm:py-8">
        <SectionHeading
          eyebrow={t("labels.statusTags")}
          title={t("projects.statusTitle")}
          description={t("projects.statusDesc")}
        />
        <div class="flex flex-wrap gap-2">
          {statusTags.map((status) => <Tag label={status} variant="accent" />)}
        </div>
        <div class="mt-6 grid gap-3">
          <div class="glass-tile px-4 py-4">
            <p class="text-sm font-semibold text-ink-950">{t("projects.externalUrl")}</p>
            <p class="mt-2.5 text-sm leading-6 text-ink-600">
              {t("projects.externalUrlDesc")}
            </p>
          </div>
          <div class="glass-tile px-4 py-4">
            <p class="text-sm font-semibold text-ink-950">{t("projects.currentNote")}</p>
            <p class="mt-2.5 text-sm leading-6 text-ink-600">
              {t("projects.currentNoteDesc")}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pt-0">
    <div class="page-shell">
      <SectionHeading
        eyebrow={t("labels.projectList")}
        title={t("projects.projectListTitle")}
        description={t("projects.projectListDesc")}
      />
      <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
        {entries.map((entry) => (
          <ProjectCard
            cover={entry.data.cover}
            date={entry.data.date}
            description={entry.data.description}
            featured={entry.data.featured}
            href={getEntryHref(entry)}
            status={entry.data.status}
            tags={entry.data.tags}
            title={entry.data.title}
          />
        ))}
      </div>
    </div>
  </section>
</ContentLayout>
