---
import DepartmentCard from "@/components/DepartmentCard.astro";
import EmptyState from "@/components/EmptyState.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { departments } from "@/data/departments";
import { useTranslations } from "@/lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);
---

<ContentLayout
  breadcrumbs={[{ label: t("departments.breadcrumb") }]}
  description={t("departments.description")}
  eyebrow={t("labels.departments")}
  title={t("departments.title")}
>
  <section class="section-shell pt-0">
    <div class="page-shell">
      <SectionHeading
        eyebrow={t("labels.structure")}
        title={t("departments.structureTitle")}
        description={t("departments.structureDesc")}
      />
      {departments[locale].length > 0 ? (
        <div class="grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
          {departments[locale].map((department) => <DepartmentCard department={department} />)}
        </div>
      ) : (
        <EmptyState
          actionHref="/en/contact"
          actionLabel={t("contact.contactAssociation")}
          description={t("departments.emptyDesc")}
          title={t("departments.emptyTitle")}
        />
      )}
    </div>
  </section>
</ContentLayout>
