---
import DepartmentCard from "@/components/DepartmentCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { departments } from "@/data/departments";
import { useTranslations } from "@/lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);
---

<ContentLayout
  breadcrumbs={[{ label: t("departments.breadcrumb") }]}
  description={t("departments.description")}
  eyebrow={t("labels.departments")}
  title={t("departments.title")}
>
  <section class="section-shell pt-0">
    <div class="page-shell">
      <SectionHeading
        eyebrow={t("labels.structure")}
        title={t("departments.structureTitle")}
        description={t("departments.structureDesc")}
      />
            <div class="grid gap-5 lg:grid-cols-2 xl:grid-cols-3">
        {departments[locale].map((department) => <DepartmentCard department={department} />)}
      </div>
    </div>
  </section>
</ContentLayout>
