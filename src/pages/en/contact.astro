---
import ContentLayout from "@/layouts/ContentLayout.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import { contactInfo } from "@/lib/site";
import { useTranslations } from "@/lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);

type ContactCard = {
  platform?: "email" | "github" | "x" | "wechat";
  label: string;
  /** 链接一律显示用户名形式，不显示整条 URL */
  value?: string;
  href?: string;
};

const handle = (url: string) => `@${new URL(url).pathname.replace(/^\//, "")}`;

const contactCards: ContactCard[] = [
  {
    platform: "email",
    label: t("contact.email"),
    value: contactInfo[locale].email,
    href: `mailto:${contactInfo[locale].email}`,
  },
  { platform: "wechat", label: t("contact.wechat"), value: contactInfo[locale].wechatName },
  {
    platform: "github",
    label: "GitHub",
    value: handle(contactInfo[locale].github),
    href: contactInfo[locale].github,
  },
  { platform: "x", label: "X", value: handle(contactInfo[locale].x), href: contactInfo[locale].x },
];
---

<ContentLayout
  breadcrumbs={[{ label: t("contact.breadcrumb") }]}
  description={t("contact.description")}
  eyebrow={t("labels.contact")}
  title={t("contact.title")}
>
  <section class="section-shell pt-0">
    <div class="page-shell">
      <div class="mx-auto grid w-full max-w-2xl gap-4 md:grid-cols-2">
      {contactCards.map((item) =>
        item.platform === "wechat" ? (
          <div class="group relative cursor-help focus:outline-none" tabindex="0">
            <article class="surface-card flex h-full items-center gap-4 px-6 py-6" data-reveal>
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-ink-200 bg-white text-ink-800 transition group-hover:border-signal-500 group-hover:text-signal-500">
                <SocialIcon label={item.label} platform="wechat" />
              </span>
              <div class="min-w-0">
                <p class="subtle-label">{item.label}</p>
                <p class="mt-2 truncate text-lg font-semibold text-ink-950">{item.value}</p>
              </div>
            </article>
            {/* 二维码放在卡片外层，否则会被 .surface-card 的 overflow:hidden 裁掉 */}
            <div class="pointer-events-none absolute left-6 top-[calc(100%+0.75rem)] z-30 w-64 rounded-3xl border border-ink-100 bg-white p-3 opacity-0 shadow-2xl shadow-ink-900/12 transition duration-200 group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100 sm:top-auto sm:bottom-[calc(100%+0.75rem)]">
              <img
                alt={t("contact.wechatQrAlt")}
                class="h-auto w-full rounded-2xl border border-ink-100"
                src="/wechat-qrcode.jpg"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        ) : (
          <article class="surface-card flex h-full items-center gap-4 px-6 py-6" data-reveal>
            {item.platform && (
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-ink-200 bg-white text-ink-800">
                <SocialIcon label={item.label} platform={item.platform} />
              </span>
            )}
            <div class="min-w-0">
              <p class="subtle-label">{item.label}</p>
              {item.href ? (
                <a
                  class="mt-2 block truncate text-lg font-semibold text-ink-950 transition hover:text-signal-500"
                  href={item.href}
                  rel={item.href.startsWith("http") ? "noreferrer" : undefined}
                  target={item.href.startsWith("http") ? "_blank" : undefined}
                >
                  {item.value}
                </a>
              ) : (
                <p class="mt-2 text-lg font-semibold text-ink-950">{item.value}</p>
              )}
            </div>
          </article>
        ),
      )}
      </div>
    </div>
  </section>
</ContentLayout>
