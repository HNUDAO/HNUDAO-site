---
import MemberCard from "@/components/MemberCard.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { members } from "@/data/members";
import { useTranslations } from "@/lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);

const advisorMembers = members[locale].filter((member) => member.group === "advisor");
const studentMembers = members[locale].filter((member) => member.group === "member");
---

<ContentLayout
  breadcrumbs={[{ label: t("members.breadcrumb") }]}
  eyebrow={t("labels.members")}
  title={t("members.title")}
>
  <section class="section-shell -mt-8 pb-6 pt-0 sm:-mt-10 sm:pb-8">
    <div class="page-shell">
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {advisorMembers.map((member) => <MemberCard member={member} />)}
      </div>
    </div>
  </section>

  <section class="section-shell pt-0">
    <div class="page-shell grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {studentMembers.map((member) => <MemberCard member={member} />)}
    </div>
  </section>
</ContentLayout>
