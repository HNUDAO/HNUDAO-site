---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { useTranslations } from "@/lib/i18n";

const locale = "en" as const;
const t = useTranslations(locale);
---

<BaseLayout description={t("notFound.description")} noindex={true} title={t("notFound.title")}>
  <main class="section-shell" id="main-content">
    <div class="page-shell">
      <section class="hero-grid overflow-hidden rounded-[2rem] border border-white/10 px-6 py-16 text-white shadow-glow sm:px-10 sm:py-20">
        <p class="hero-badge">
          <span class="h-2 w-2 rounded-full bg-gold-300"></span>
          404 Not Found
        </p>
        <h1 class="mt-8 text-5xl font-semibold tracking-tight sm:text-6xl">{t("notFound.heading")}</h1>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-white/78">
          {t("notFound.message")}
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a
            class="focus-ring inline-flex items-center justify-center rounded-full bg-jade-300 px-6 py-3 text-sm font-semibold text-ink-950 transition hover:bg-jade-100"
            href="/en/"
          >
            {t("notFound.backHome")}
          </a>
          <a
            class="focus-ring inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:border-white/25 hover:bg-white/10"
            href="/en/news"
          >
            {t("notFound.viewNews")}
          </a>
          <a
            class="focus-ring inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:border-white/25 hover:bg-white/10"
            href="/en/activities"
          >
            {t("notFound.viewActivities")}
          </a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
