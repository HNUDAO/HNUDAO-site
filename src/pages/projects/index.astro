---
import ProjectCard from "@/components/ProjectCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import Tag from "@/components/Tag.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import { getEntryHref, isExternalHref, isPublished, sortEntriesByDate } from "@/lib/content";
import { getCollection } from "astro:content";

const entries = sortEntriesByDate((await getCollection("projects")).filter(isPublished), "date");
const featured = entries.find((entry) => entry.data.featured);
const statusTags = ["planning", "active", "archived"];
const featuredHref = featured ? getEntryHref(featured) : "#";
const featuredExternal = isExternalHref(featuredHref);
---

<ContentLayout
  breadcrumbs={[{ label: "项目展示" }]}
  description="项目展示页用于长期沉淀协会项目、课程实践与开源成果，卡片可直接跳转到仓库或外部演示地址。"
  eyebrow="Projects"
  title="项目展示"
>
  <section class="section-shell pt-0">
    <div class="page-shell grid gap-5 lg:grid-cols-[1.02fr_0.98fr]">
      {featured && (
        <div class="surface-card overflow-hidden">
          <img
            alt={`${featured.data.title} 项目封面`}
            class="aspect-[16/8] w-full object-cover"
            height="480"
            src={featured.data.cover || "/images/placeholder-cover.svg"}
            width="960"
          />
          <div class="px-5 py-7 sm:px-7 sm:py-8">
            <p class="subtle-label">Featured Project</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-ink-950">{featured.data.title}</h2>
            <p class="mt-4 text-base leading-8 text-ink-600">{featured.data.description}</p>
            <a
              class="glass-button focus-ring mt-8 inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold text-ink-900 transition hover:text-signal-500"
              href={featuredHref}
              rel={featuredExternal ? "noreferrer" : undefined}
              target={featuredExternal ? "_blank" : undefined}
            >
              打开项目链接
            </a>
          </div>
        </div>
      )}

      <div class="surface-card px-5 py-7 sm:px-7 sm:py-8">
        <SectionHeading
          eyebrow="Status Tags"
          title="项目状态"
          description="项目支持规划中、进行中、已归档三种状态，适合长期维护与版本化沉淀。"
        />
        <div class="flex flex-wrap gap-2">
          {statusTags.map((status) => <Tag label={status} variant="accent" />)}
        </div>
        <div class="mt-6 grid gap-3">
          <div class="glass-tile px-4 py-4">
            <p class="text-sm font-semibold text-ink-950">外部地址</p>
            <p class="mt-2.5 text-sm leading-6 text-ink-600">
              项目可以指向 GitHub 仓库、Demo 页面、文档页或其他公开演示地址。
            </p>
          </div>
          <div class="glass-tile px-4 py-4">
            <p class="text-sm font-semibold text-ink-950">当前说明</p>
            <p class="mt-2.5 text-sm leading-6 text-ink-600">
              当前项目页展示的是协会正在建设或计划推进的公开方向，后续会逐步替换为真实成果链接。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-shell pt-0">
    <div class="page-shell">
      <SectionHeading
        eyebrow="Project List"
        title="项目列表"
        description="点击卡片后可直接进入项目仓库、演示地址或其他公开资料页。"
      />
      <div class="grid gap-4 lg:grid-cols-2 xl:grid-cols-3">
        {entries.map((entry) => (
          <ProjectCard
            cover={entry.data.cover}
            date={entry.data.date}
            description={entry.data.description}
            featured={entry.data.featured}
            href={getEntryHref(entry)}
            status={entry.data.status}
            tags={entry.data.tags}
            title={entry.data.title}
          />
        ))}
      </div>
    </div>
  </section>
</ContentLayout>
