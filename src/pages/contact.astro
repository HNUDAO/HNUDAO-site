---
import SectionHeading from "@/components/SectionHeading.astro";
import ContentLayout from "@/layouts/ContentLayout.astro";
import SocialIcon from "@/components/SocialIcon.astro";
import { contactInfo, socialLinks } from "@/lib/site";

const contactCards = [
  { label: "邮箱", value: contactInfo.email, href: `mailto:${contactInfo.email}` },
  { label: "微信公众号", value: contactInfo.wechatOfficial },
  { label: "QQ 群", value: contactInfo.qqGroup },
  { label: "GitHub", value: contactInfo.github, href: contactInfo.github },
  { label: "X", value: contactInfo.x, href: contactInfo.x },
  { label: "地址", value: contactInfo.address },
  { label: "合作与咨询", value: contactInfo.principal },
];
---

<ContentLayout
  breadcrumbs={[{ label: "联系我们" }]}
  description="查看 HNUDAO 当前公开的联系渠道与官方平台入口。"
  eyebrow="Contact"
  title="联系我们"
>
  <section class="section-shell pt-0">
    <div class="page-shell">
      <SectionHeading
        eyebrow="Channels"
        title="官方渠道"
        description="目前对外开放的渠道包括 GitHub、X 与微信公众号。邮箱、QQ群等更多方式会在正式启用后继续补充。"
      />
      <div class="mb-8 flex flex-wrap gap-3">
        {socialLinks.map((link) => (
          link.platform === "wechat" ? (
            <div class="group relative">
              <button
                class="focus-ring inline-flex h-12 w-12 items-center justify-center rounded-full border border-ink-200 bg-white text-ink-800 transition hover:border-signal-500 hover:text-signal-500"
                type="button"
              >
                <SocialIcon label={link.label} platform={link.platform} />
              </button>
              <div class="pointer-events-none absolute bottom-[calc(100%+1rem)] left-1/2 z-20 w-48 -translate-x-1/2 translate-y-2 rounded-3xl border border-ink-100 bg-white p-3 text-center opacity-0 shadow-2xl shadow-ink-900/12 transition duration-200 group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <img
                  alt="HNUDAO 微信公众号二维码"
                  class="h-auto w-full rounded-2xl border border-ink-100"
                  src="/qrcode_for公众号.jpg"
                />
                <p class="mt-3 text-xs leading-6 text-ink-600">微信扫码关注 HNUDAO 公众号</p>
              </div>
            </div>
          ) : (
            <a
              class="focus-ring inline-flex h-12 w-12 items-center justify-center rounded-full border border-ink-200 bg-white text-ink-800 transition hover:border-signal-500 hover:text-signal-500"
              href={link.href}
              rel="noreferrer"
              target={link.platform === "email" ? undefined : "_blank"}
            >
              <SocialIcon label={link.label} platform={link.platform} />
            </a>
          )
        ))}
      </div>
      <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {contactCards.map((item) => (
          <article class="surface-card h-full px-6 py-7">
            <p class="subtle-label">{item.label}</p>
            {item.href ? (
              <a
                class="mt-4 block text-xl font-semibold text-ink-950 transition hover:text-signal-500"
                href={item.href}
                rel={item.href.startsWith("mailto:") ? undefined : "noreferrer"}
                target={item.href.startsWith("mailto:") ? undefined : "_blank"}
              >
                {item.value}
              </a>
            ) : (
              <p class="mt-4 text-xl font-semibold text-ink-950">{item.value}</p>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
</ContentLayout>
