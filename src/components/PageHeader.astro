---
import GinkgoLeaf from "./GinkgoLeaf.astro";

type Props = {
  eyebrow?: string;
  title: string;
};

const { eyebrow, title } = Astro.props;
---

<header class="surface-card relative overflow-hidden px-5 py-8 sm:px-8 sm:py-11" data-reveal>
  <GinkgoLeaf class="page-ginkgo page-ginkgo-top-left" variant="leaf1" />
  <GinkgoLeaf class="page-ginkgo page-ginkgo-left" variant="leaf3" />
  <GinkgoLeaf class="page-ginkgo page-ginkgo-right" variant="leaf3" />
  <GinkgoLeaf class="page-ginkgo page-ginkgo-bottom-right" variant="leaf2" />
  <div class="absolute left-0 top-0 h-1.5 w-28 rounded-r-full bg-gradient-to-r from-signal-500 to-jade-500"></div>
  <div class="absolute inset-y-0 right-0 hidden w-1/3 bg-gradient-to-l from-jade-100/70 to-transparent sm:block"></div>
  <div class="relative max-w-3xl">
    {eyebrow && <p class="subtle-label mb-3 !text-signal-500">{eyebrow}</p>}
    <h1 class="text-balance text-[2.1rem] font-semibold tracking-tight text-ink-950 sm:text-[2.75rem]">{title}</h1>
  </div>
  <slot name="actions" />
</header>
