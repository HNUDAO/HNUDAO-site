---
import type { Member } from "@/data/members";
import { getLocaleFromPath, useTranslations } from "@/lib/i18n";
import SocialIcon from "./SocialIcon.astro";
import Tag from "./Tag.astro";

type Props = {
  member: Member;
};

const { member } = Astro.props;
const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const xUrl = member.x ? `https://x.com/${member.x}` : undefined;
const tags = [member.department, member.grade].filter((label): label is string => Boolean(label));
const linkItems = [
  member.github
    ? { href: member.github, label: "GitHub", platform: "github" as const }
    : null,
  member.email
    ? { href: `mailto:${member.email}`, label: t("common.email"), platform: "email" as const }
    : null,
].filter((item): item is NonNullable<typeof item> => Boolean(item));
---

<article class="surface-card flex h-full flex-col px-5 py-5" data-reveal>
  <div class="flex items-center justify-between gap-3">
    <div class="flex min-w-0 items-center gap-3.5">
      {member.avatar && (
        <img
          alt=""
          aria-hidden="true"
          class="h-14 w-14 rounded-[1rem] border border-ink-100 object-cover"
          height="64"
          loading="lazy"
          src={member.avatar}
          width="64"
          decoding="async"
        />
      )}
      <div class="min-w-0">
        <p class="text-sm font-medium text-signal-500">{member.role}</p>
        <h3 class="mt-1 text-[1.05rem] font-semibold text-ink-950">
          {member.personalSite ? (
            <a
              class="focus-ring transition hover:text-signal-500"
              href={member.personalSite}
              rel="noreferrer"
              target="_blank"
            >
              {member.name}
            </a>
          ) : (
            member.name
          )}
        </h3>
        {xUrl && (
          <a
            class="focus-ring mt-1 inline-block text-sm text-ink-500 transition hover:text-signal-500"
            href={xUrl}
            rel="noreferrer"
            target="_blank"
          >
            @{member.x}
          </a>
        )}
      </div>
    </div>
    {linkItems.length > 0 && (
      <div class="flex shrink-0 items-center gap-2">
        {linkItems.map((item) => (
          <a
            class="focus-ring inline-flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 bg-white text-ink-700 transition hover:border-jade-500 hover:text-signal-500"
            href={item.href}
            rel="noreferrer"
            target={item.platform === "email" ? undefined : "_blank"}
          >
            <SocialIcon label={item.label} platform={item.platform} />
          </a>
        ))}
      </div>
    )}
  </div>
  {tags.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5">
      {tags.map((label) => <Tag label={label} />)}
    </div>
  )}
  {member.bio && <p class="mt-4 text-[0.84rem] leading-6 text-ink-600">{member.bio}</p>}
</article>
