---
import type { Member } from "@/data/members";
import SocialIcon from "./SocialIcon.astro";
import Tag from "./Tag.astro";

type Props = {
  member: Member;
};

const { member } = Astro.props;
const initials = member.name.replace(/\s+/g, "").slice(0, 2) || "待补";
const linkItems = [
  member.github
    ? { href: member.github, label: "GitHub", platform: "github" as const }
    : null,
  member.email
    ? { href: `mailto:${member.email}`, label: "邮箱", platform: "email" as const }
    : null,
  member.personalSite
    ? { href: member.personalSite, label: "个人主页", platform: "website" as const }
    : null,
].filter(Boolean);
---

<article class="surface-card flex h-full flex-col px-5 py-5" data-reveal>
  <div class="flex items-center gap-3.5">
    {member.avatar ? (
      <img
        alt={`${member.name} 头像`}
        class="h-14 w-14 rounded-[1rem] border border-ink-100 object-cover"
        height="64"
        src={member.avatar}
        width="64"
      />
    ) : (
      <div class="flex h-14 w-14 items-center justify-center rounded-[1rem] bg-ink-100 text-base font-semibold text-ink-700">
        {initials}
      </div>
    )}
    <div>
      <h3 class="text-[1.05rem] font-semibold text-ink-950">{member.name}</h3>
      <p class="mt-1 text-sm text-ink-500">{member.role}</p>
    </div>
  </div>
  <div class="mt-4 flex flex-wrap gap-1.5">
    <Tag label={member.department} />
    <Tag label={member.grade} />
  </div>
  <p class="mt-4 text-[0.84rem] leading-6 text-ink-600">{member.bio}</p>
  <div class="mt-5 flex items-center justify-between gap-4 border-t border-ink-100 pt-4">
    <p class="text-sm text-ink-500">相关链接</p>
    {linkItems.length > 0 ? (
      <div class="flex items-center gap-2">
        {linkItems.map((item) => (
          <a
            class="focus-ring inline-flex h-9 w-9 items-center justify-center rounded-full border border-ink-200 bg-white text-ink-700 transition hover:border-jade-500 hover:text-signal-500"
            href={item.href}
            rel="noreferrer"
            target={item.platform === "email" ? undefined : "_blank"}
          >
            <SocialIcon label={item.label} platform={item.platform} />
          </a>
        ))}
      </div>
    ) : (
      <span class="text-sm text-ink-400">暂未公开</span>
    )}
  </div>
</article>
