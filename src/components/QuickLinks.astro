---
import type { QuickLink } from "@/lib/site";
import { useTranslations, type Locale } from "@/lib/i18n";

type Props = {
  links: QuickLink[];
  locale: Locale;
};

const { links, locale } = Astro.props;
const t = useTranslations(locale);
---

<div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
  {links.map((link) => (
    <a
      class="focus-ring surface-card group flex h-full flex-col justify-between px-4 py-4.5 transition hover:-translate-y-1 hover:border-jade-200"
      data-reveal
      href={link.href}
    >
      <div>
        <p class="subtle-label">{t("common.quickLink")}</p>
        <h3 class="mt-2.5 text-[1.05rem] font-semibold text-ink-900 transition group-hover:text-jade-700">{link.title}</h3>
        <p class="mt-2.5 text-[0.84rem] leading-6 text-ink-600">{link.description}</p>
      </div>
      <span class="mt-6 text-sm font-semibold text-ink-900">{t("common.viewMore")}</span>
    </a>
  ))}
</div>
