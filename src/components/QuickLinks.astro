---
import type { QuickLink } from "@/lib/site";

type Props = {
  links: QuickLink[];
};

const { links } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">
  {links.map((link) => (
    <a
      class="focus-ring surface-card group flex h-full flex-col justify-between px-5 py-6 transition hover:-translate-y-1 hover:border-jade-200"
      data-reveal
      href={link.href}
    >
      <div>
        <p class="subtle-label">Quick Link</p>
        <h3 class="mt-3 text-xl font-semibold text-ink-900 transition group-hover:text-jade-700">{link.title}</h3>
        <p class="mt-3 text-sm leading-7 text-ink-600">{link.description}</p>
      </div>
      <span class="mt-6 text-sm font-semibold text-ink-900">查看板块</span>
    </a>
  ))}
</div>
