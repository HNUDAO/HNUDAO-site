---
import GinkgoLeaf from "./GinkgoLeaf.astro";
---

<section class="hero-shell relative" data-home-cover-shell>
  <div class="hero-grid hero-cover sticky top-0 overflow-hidden" data-home-cover>
    <div class="hero-glow absolute inset-0"></div>
    <div class="tech-grid absolute inset-0 opacity-70"></div>
    <div class="bg-noise absolute inset-0 opacity-[0.035]"></div>
    <div class="floating-dot hero-dot-1"></div>
    <div class="floating-dot hero-dot-2"></div>
    <div class="floating-dot hero-dot-3"></div>
    <GinkgoLeaf class="ginkgo-leaf ginkgo-leaf-hero-left" />
    <GinkgoLeaf class="ginkgo-leaf ginkgo-leaf-hero-right" />
    <GinkgoLeaf class="ginkgo-leaf ginkgo-leaf-hero-bottom" />
    <div class="hero-fade absolute inset-x-0 bottom-0 h-48"></div>

    <div class="page-shell relative grid min-h-screen place-items-center pb-14 pt-8 sm:pb-16 sm:pt-10">
      <div class="hero-logo-cluster" data-home-logo-stage>
        <div class="hero-logo-stage">
          <div class="hero-orbit hero-orbit-1"></div>
          <div class="hero-orbit hero-orbit-2"></div>
          <div class="hero-orbit hero-orbit-3"></div>
          <span class="hero-orbit-dot hero-orbit-dot-1" aria-hidden="true"></span>
          <span class="hero-orbit-dot hero-orbit-dot-2" aria-hidden="true"></span>
          <img
            alt="HNUDAO Logo"
            class="hero-logo relative z-10 h-auto w-[22rem] object-contain sm:w-[30rem] lg:w-[40rem]"
            src="/logo-placeholder.svg"
          />
        </div>
      </div>
    </div>

    <a
      aria-label="Scroll to content"
      class="hero-scroll-indicator focus-ring absolute bottom-8 left-1/2 flex -translate-x-1/2 flex-col items-center gap-3 rounded-full px-4 py-3 text-xs uppercase tracking-[0.28em] text-ink-500"
      data-home-scroll-indicator
      href="#home-intro"
    >
      <span>Scroll</span>
      <span aria-hidden="true" class="hero-scroll-arrow"></span>
    </a>
  </div>

  <div aria-hidden="true" class="hero-transition-spacer"></div>
</section>
