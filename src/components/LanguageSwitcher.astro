---
import { getLocaleFromPath } from "@/lib/i18n";

const locale = getLocaleFromPath(Astro.url.pathname);
const currentPath = Astro.url.pathname;

const targetLocale = locale === "zh-CN" ? "en" : "zh-CN";
// 404 页没有对应的另一语言路径（中文 404 构建为 /404.html），统一指到该语言首页
const isNotFound = /^\/(en\/)?404(\/|\.html)?$/.test(currentPath);
const targetPath = isNotFound
  ? locale === "zh-CN"
    ? "/en/"
    : "/"
  : locale === "zh-CN"
    ? `/en${currentPath}`
    : currentPath.replace(/^\/en/, "") || "/";
---
<a
  class="focus-ring inline-flex items-center justify-center rounded-full px-3 py-1.5 text-[0.82rem] font-medium text-ink-700 transition hover:text-signal-500"
  href={targetPath}
  hreflang={targetLocale}
>
  {locale === "zh-CN" ? "EN" : "中文"}
</a>
