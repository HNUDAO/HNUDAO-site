---
type Props = {
  label: string;
  value: string;
  note?: string;
};

const { label, value, note } = Astro.props;
---

<div class="surface-card px-5 py-6" data-reveal>
  <p class="subtle-label">{label}</p>
  <p class="mt-3 text-3xl font-semibold tracking-tight text-ink-950">{value}</p>
  {note && <p class="mt-2 text-sm leading-6 text-ink-500">{note}</p>}
</div>
