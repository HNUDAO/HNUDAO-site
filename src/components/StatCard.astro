---
type Props = {
  label: string;
  value: string;
  note?: string;
};

const { label, value, note } = Astro.props;
---

<div class="surface-card px-4 py-4.5" data-reveal>
  <p class="subtle-label">{label}</p>
  <p class="mt-2.5 text-[2rem] font-semibold tracking-tight text-ink-950">{value}</p>
  {note && <p class="mt-1.5 text-[0.82rem] leading-5 text-ink-500">{note}</p>}
</div>
