---
import { navItems, siteShortName } from "@/lib/site";
import { getLocaleFromPath, useTranslations } from "@/lib/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const currentNavItems = navItems[locale];
const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/" || href === "/en/") {
    return pathname === "/" || pathname === "/en/";
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="site-header sticky top-0 z-40" data-site-header>
  <div class="page-shell site-header-inner flex min-h-[3.35rem] items-center justify-between gap-4">
    <a class="focus-ring flex items-center gap-2.5 rounded-[0.95rem] px-1 py-1" href={locale === "en" ? "/en/" : "/"}>
      <img
        alt="HNUDAO Logo"
        class="h-[2.55rem] w-auto max-w-[188px] object-contain sm:h-[2.8rem] sm:max-w-[218px] lg:h-[3.2rem] lg:max-w-[262px]"
        src="/logo-placeholder.svg"
      />
      <span class="sr-only">{siteShortName}</span>
    </a>

    <div class="hidden items-center gap-1.5 lg:flex">
      <nav aria-label="Primary navigation" class="flex items-center gap-1.5">
        {currentNavItems.map((item) => (
          <a
            class:list={[
              "site-nav-link focus-ring rounded-full px-3 py-1.5 text-[0.82rem] font-medium transition",
              isActive(item.href)
                ? "bg-signal-500 text-white shadow-sm"
                : "text-ink-700 hover:text-signal-500",
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <span class="mx-1 h-4 w-px bg-ink-200" aria-hidden="true"></span>
      <LanguageSwitcher />
    </div>

    <button
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="site-mobile-toggle focus-ring inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-900 transition hover:text-signal-500 lg:hidden"
      data-nav-toggle
      type="button"
    >
      <span class="sr-only">{t("common.openMenu")}</span>
      <svg
        aria-hidden="true"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="1.8"
        viewBox="0 0 24 24"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <div class="site-mobile-menu hidden lg:hidden" data-mobile-menu id="mobile-menu">
    <nav aria-label="Mobile navigation" class="page-shell flex flex-col py-4">
      {currentNavItems.map((item) => (
        <a
          class:list={[
            "focus-ring rounded-2xl px-4 py-3 text-sm font-medium transition",
            isActive(item.href)
              ? "bg-signal-500 text-white"
              : "text-ink-700 hover:bg-white/70 hover:text-signal-500",
          ]}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
      <div class="mt-2 border-t border-ink-100 px-4 pt-3">
        <LanguageSwitcher />
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden");
    });
  }
</script>
