---
import { navItems, siteShortName } from "@/lib/site";
import { getLocaleFromPath, useTranslations } from "@/lib/i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const currentNavItems = navItems[locale];
const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/" || href === "/en/") {
    return pathname === "/" || pathname === "/en/";
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="site-header sticky top-0 z-40" data-site-header>
  <div class="page-shell site-header-inner flex min-h-[3.35rem] items-center justify-between gap-4">
    <a class="focus-ring flex items-center gap-2.5 rounded-[0.95rem] px-1 py-1" href={locale === "en" ? "/en/" : "/"}>
      <img
        alt="HNUDAO Logo"
        class="h-[2.55rem] w-auto max-w-[188px] object-contain sm:h-[2.8rem] sm:max-w-[218px] lg:h-[3.2rem] lg:max-w-[262px]"
        src="/logo-placeholder.svg"
      />
      <span class="sr-only">{siteShortName}</span>
    </a>

    <div class="hidden items-center gap-1.5 lg:flex">
      <nav aria-label="Primary navigation" class="flex items-center gap-1.5">
        {currentNavItems.map((item) => (
          <a
            class:list={[
              "site-nav-link focus-ring rounded-full px-3 py-1.5 text-[0.82rem] font-medium transition",
              isActive(item.href)
                ? "bg-signal-500 text-white shadow-sm"
                : "text-ink-700 hover:text-signal-500",
            ]}
            href={item.href}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <span class="mx-1 h-4 w-px bg-ink-200" aria-hidden="true"></span>
      <LanguageSwitcher />
      <button
        aria-label={t("common.toggleTheme")}
        class="site-theme-toggle focus-ring inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-900 transition hover:text-signal-500"
        data-theme-toggle
        title={t("common.toggleTheme")}
        type="button"
      >
        <svg aria-hidden="true" class="theme-icon theme-icon-sun" fill="none" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path>
        </svg>
        <svg aria-hidden="true" class="theme-icon theme-icon-moon" fill="none" viewBox="0 0 24 24">
          <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z" fill="currentColor"></path>
        </svg>
        <span class="sr-only">{t("common.toggleTheme")}</span>
      </button>
    </div>

    <button
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="site-mobile-toggle focus-ring inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-900 transition hover:text-signal-500 lg:hidden"
      data-nav-toggle
      type="button"
    >
      <span class="sr-only">{t("common.openMenu")}</span>
      <svg
        aria-hidden="true"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="1.8"
        viewBox="0 0 24 24"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <div class="site-mobile-menu hidden lg:hidden" data-mobile-menu id="mobile-menu">
    <nav aria-label="Mobile navigation" class="page-shell flex flex-col py-4">
      {currentNavItems.map((item) => (
        <a
          class:list={[
            "focus-ring rounded-2xl px-4 py-3 text-sm font-medium transition",
            isActive(item.href)
              ? "bg-signal-500 text-white"
              : "text-ink-700 hover:bg-white/70 hover:text-signal-500",
          ]}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
      <div class="mt-2 border-t border-ink-100 px-4 pt-3">
        <div class="flex items-center justify-between">
          <LanguageSwitcher />
          <button
            aria-label={t("common.toggleTheme")}
            class="site-theme-toggle focus-ring inline-flex h-9 w-9 items-center justify-center rounded-full text-ink-900 transition hover:text-signal-500"
            data-theme-toggle
            title={t("common.toggleTheme")}
            type="button"
          >
            <svg aria-hidden="true" class="theme-icon theme-icon-sun" fill="none" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" fill="currentColor"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke="currentColor" stroke-linecap="round" stroke-width="1.7"></path>
            </svg>
            <svg aria-hidden="true" class="theme-icon theme-icon-moon" fill="none" viewBox="0 0 24 24">
              <path d="M20.5 14.1A8.5 8.5 0 0 1 9.9 3.5 8.5 8.5 0 1 0 20.5 14.1Z" fill="currentColor"></path>
            </svg>
            <span class="sr-only">{t("common.toggleTheme")}</span>
          </button>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  if (document.documentElement.dataset.hnudaoHeaderEvents !== "true") {
    document.documentElement.dataset.hnudaoHeaderEvents = "true";

    const applyTheme = (root: HTMLElement, theme: string | null) => {
      root.classList.toggle("dark", theme === "dark");
      root.classList.toggle("light", theme !== "dark");
    };

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target.closest("[data-nav-toggle]") : null;
      const themeToggle = event.target instanceof Element ? event.target.closest("[data-theme-toggle]") : null;

      if (themeToggle instanceof HTMLButtonElement) {
        const current = document.documentElement.classList.contains("dark");
        const next = current ? "light" : "dark";
        localStorage.setItem("hnudao-theme", next);
        applyTheme(document.documentElement, next);
        return;
      }

      if (!(target instanceof HTMLButtonElement)) return;

      const header = target.closest("[data-site-header]");
      const menu = header?.querySelector("[data-mobile-menu]");
      if (!(menu instanceof HTMLElement)) return;

      const expanded = target.getAttribute("aria-expanded") === "true";
      target.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden");
    });

    document.addEventListener("astro:before-swap", (event) => {
      const newDocument = (event as Event & { newDocument: Document }).newDocument;
      applyTheme(newDocument.documentElement, localStorage.getItem("hnudao-theme"));
    });

    document.addEventListener("astro:after-swap", () => {
      document.querySelectorAll("[data-mobile-menu]").forEach((menu) => menu.classList.add("hidden"));
      document
        .querySelectorAll("[data-nav-toggle]")
        .forEach((toggle) => toggle.setAttribute("aria-expanded", "false"));
    });
  }
</script>
