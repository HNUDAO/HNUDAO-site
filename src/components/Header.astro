---
import { navItems, siteShortName } from "@/lib/site";

const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === "/") {
    return pathname === "/";
  }

  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class="site-header sticky top-0 z-40" data-site-header>
  <div class="page-shell site-header-inner flex min-h-[5.9rem] items-center justify-between gap-6">
    <a class="focus-ring flex items-center gap-4 rounded-2xl px-1 py-2" href="/">
      <img
        alt="HNUDAO Logo"
        class="h-[4.6rem] w-auto max-w-[340px] object-contain sm:h-[5rem] sm:max-w-[400px] lg:h-[5.5rem] lg:max-w-[460px]"
        src="/logo-placeholder.svg"
      />
      <span class="sr-only">{siteShortName}</span>
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-1.5 lg:flex">
      {navItems.map((item) => (
        <a
          class:list={[
            "site-nav-link focus-ring rounded-full px-4 py-2.5 text-sm font-medium transition",
            isActive(item.href)
              ? "bg-signal-500 text-white shadow-sm"
              : "text-ink-700 hover:text-signal-500",
          ]}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <button
      aria-controls="mobile-menu"
      aria-expanded="false"
      class="site-mobile-toggle focus-ring inline-flex h-11 w-11 items-center justify-center rounded-full text-ink-900 transition hover:text-signal-500 lg:hidden"
      data-nav-toggle
      type="button"
    >
      <span class="sr-only">Open menu</span>
      <svg
        aria-hidden="true"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="1.8"
        viewBox="0 0 24 24"
      >
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <div class="site-mobile-menu hidden lg:hidden" data-mobile-menu id="mobile-menu">
    <nav aria-label="Mobile navigation" class="page-shell flex flex-col py-4">
      {navItems.map((item) => (
        <a
          class:list={[
            "focus-ring rounded-2xl px-4 py-3 text-sm font-medium transition",
            isActive(item.href)
              ? "bg-signal-500 text-white"
              : "text-ink-700 hover:bg-white/70 hover:text-signal-500",
          ]}
          href={item.href}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const menu = document.querySelector("[data-mobile-menu]");

  if (toggle instanceof HTMLButtonElement && menu instanceof HTMLElement) {
    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden");
    });
  }
</script>
