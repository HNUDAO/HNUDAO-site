---
type Props = {
  eyebrow?: string;
  title: string;
  description: string;
  primaryLabel: string;
  primaryHref: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  tone?: "default" | "home";
};

const {
  eyebrow,
  title,
  description,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  tone = "default",
} = Astro.props;
---

<section
  class:list={[
    "surface-card-dark relative overflow-hidden px-6 py-10 sm:px-10 sm:py-14",
    tone === "home" &&
      "bg-[linear-gradient(160deg,rgba(52,27,24,0.72),rgba(110,35,31,0.68)),radial-gradient(circle_at_top_left,rgba(205,152,112,0.18),transparent_36%)]",
  ]}
  data-reveal
>
  <div
    class:list={[
      "absolute inset-y-0 right-0 hidden w-1/2 bg-gradient-to-l lg:block",
      tone === "home" ? "from-[#cd9870]/16 to-transparent" : "from-signal-500/10 to-transparent",
    ]}
  ></div>
  <div class="relative flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
      {eyebrow && <p class="mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-jade-300/80">{eyebrow}</p>}
      <h2 class="text-balance text-3xl font-semibold tracking-tight text-white sm:text-4xl">{title}</h2>
      <p class="mt-4 max-w-2xl text-base leading-8 text-white/75">{description}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a
        class="focus-ring inline-flex items-center justify-center rounded-full bg-jade-500 px-5 py-3 text-sm font-semibold text-ink-950 transition hover:-translate-y-0.5 hover:bg-jade-300"
        href={primaryHref}
      >
        {primaryLabel}
      </a>
      {secondaryLabel && secondaryHref && (
        <a
          class="focus-ring inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/10"
          href={secondaryHref}
        >
          {secondaryLabel}
        </a>
      )}
    </div>
  </div>
</section>
