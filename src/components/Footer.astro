---
import {
  contactInfo,
  footerLinks,
  organizationName,
  siteDescription,
  siteShortName,
  socialLinks,
} from "@/lib/site";
import SocialIcon from "./SocialIcon.astro";
---

<footer class="mt-20 border-t border-ink-100 bg-ink-950 text-white">
  <div class="page-shell py-14">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr]">
      <div>
        <p class="text-sm uppercase tracking-[0.32em] text-jade-300/80">{siteShortName}</p>
        <h2 class="mt-4 text-3xl font-semibold tracking-tight">{organizationName}</h2>
        <p class="mt-5 max-w-2xl text-base leading-8 text-white/68">{siteDescription}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          {socialLinks.map((link) => (
            link.platform === "wechat" ? (
              <div class="group relative">
                <button
                  class="focus-ring inline-flex h-12 w-12 items-center justify-center rounded-full border border-jade-500/20 bg-white/5 text-white transition hover:border-jade-500/40 hover:bg-white/10"
                  type="button"
                >
                  <SocialIcon label={link.label} platform={link.platform} />
                </button>
                <div class="pointer-events-none absolute bottom-[calc(100%+1rem)] left-1/2 z-20 w-48 -translate-x-1/2 translate-y-2 rounded-3xl border border-white/10 bg-white/95 p-3 text-center opacity-0 shadow-2xl shadow-black/30 transition duration-200 group-hover:pointer-events-auto group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:translate-y-0 group-focus-within:opacity-100">
                  <img
                    alt="HNUDAO 微信公众号二维码"
                    class="h-auto w-full rounded-2xl border border-ink-100"
                    src="/qrcode_for公众号.jpg"
                  />
                  <p class="mt-3 text-xs leading-6 text-ink-600">微信扫码关注 HNUDAO 公众号</p>
                </div>
              </div>
            ) : (
              <a
                class="focus-ring inline-flex h-12 w-12 items-center justify-center rounded-full border border-jade-500/20 bg-white/5 text-white transition hover:border-jade-500/40 hover:bg-white/10"
                href={link.href}
                rel={link.href.startsWith("http") ? "noreferrer" : undefined}
                target={link.href.startsWith("http") ? "_blank" : undefined}
              >
                <SocialIcon label={link.label} platform={link.platform} />
              </a>
            )
          ))}
        </div>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {footerLinks.map((group) => (
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.22em] text-white/55">{group.title}</h3>
            <ul class="mt-4 space-y-3 text-sm text-white/70">
              {group.items.map((item) => (
                <li>
                  <a class="focus-ring rounded-md px-1 py-0.5 transition hover:text-white" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
        <div>
          <h3 class="text-sm font-semibold uppercase tracking-[0.22em] text-white/55">联系信息</h3>
          <ul class="mt-4 space-y-3 text-sm text-white/70">
            <li>邮箱：{contactInfo.email}</li>
            <li>公众号：{contactInfo.wechatOfficial}</li>
            <li>地址：{contactInfo.address}</li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-12 border-t border-white/10 pt-6 text-sm text-white/45">
      <p>© 2026 HNUDAO. 网站内容将由协会持续更新维护。</p>
    </div>
  </div>
</footer>
