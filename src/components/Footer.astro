---
import {
  contactInfo,
  organizationName,
  siteDescription,
  siteShortName,
  socialLinks,
} from "@/lib/site";
import SocialIcon from "./SocialIcon.astro";
---

<footer class="mt-16 border-t border-[rgba(170,137,109,0.14)] bg-[linear-gradient(180deg,#f8f4ee_0%,#f3ebe2_100%)] text-ink-900">
  <div class="page-shell py-9 sm:py-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-2xl">
        <p class="text-[0.72rem] font-semibold uppercase tracking-[0.3em] text-signal-500">{siteShortName}</p>
        <h2 class="mt-2.5 text-[1.35rem] font-semibold tracking-tight text-ink-950 sm:text-[1.7rem]">
          {organizationName}
        </h2>
        <p class="mt-3 max-w-xl text-[0.9rem] leading-6 text-ink-600">{siteDescription}</p>
      </div>

      <div class="flex flex-wrap gap-2.5 lg:justify-end">
        {socialLinks.map((link) => (
          <a
            class="focus-ring inline-flex h-9 w-9 items-center justify-center rounded-full border border-[rgba(170,137,109,0.18)] bg-white/74 text-ink-700 transition hover:border-signal-500/30 hover:text-signal-500"
            href={link.platform === "wechat" ? "#" : link.href}
            rel={link.href.startsWith("http") ? "noreferrer" : undefined}
            target={link.href.startsWith("http") ? "_blank" : undefined}
          >
            <SocialIcon label={link.label} platform={link.platform} />
          </a>
        ))}
      </div>
    </div>

    <div class="mt-7 flex flex-col gap-2 border-t border-[rgba(170,137,109,0.14)] pt-4 text-[0.78rem] text-ink-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© 2026 HNUDAO</p>
      <p>
        <a class="focus-ring transition hover:text-signal-500" href={`mailto:${contactInfo.email}`}>
          {contactInfo.email}
        </a>
        <span> · {contactInfo.address}</span>
      </p>
    </div>
  </div>
</footer>
