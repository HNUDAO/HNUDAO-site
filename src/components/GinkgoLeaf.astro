    <path d="M110.2 143.6C113.9 116.5 116 90.1 116.4 54.2" stroke-width="1.58" opacity="0.78" />

    <!-- 左侧细密叶脉：模拟参考图中很多细线向外扩散 -->
    <path d="M110.2 143.6C98.3 134.9 87.9 128.2 75.4 121.7" stroke-width="1.35" opacity="0.72" />
    <path d="M110.2 143.6C96.9 131.9 84.8 122.1 69.9 112.1" stroke-width="1.32" opacity="0.72" />
    <path d="M110.2 143.6C95.8 128.8 83.1 115.4 67.1 99.1" stroke-width="1.28" opacity="0.7" />
    <path d="M110.2 143.6C96.2 125.5 83.7 108.3 68.8 86.7" stroke-width="1.24" opacity="0.7" />
    <path d="M110.2 143.6C98.1 122.8 87.4 102.5 75.6 76.1" stroke-width="1.2" opacity="0.68" />
    <path d="M110.2 143.6C100.8 120.3 93.4 98.5 86.7 70.4" stroke-width="1.16" opacity="0.68" />
    <path d="M110.2 143.6C104.3 118.8 100.2 95.3 97.6 66.1" stroke-width="1.12" opacity="0.66" />

    <!-- 右侧细密叶脉 -->
