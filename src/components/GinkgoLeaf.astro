        C166.2 112.2 154.1 122.4 140.2 129.7
        C128.3 136 116.6 140.1 110.2 143.6
        Z
      "
      stroke-width="3.2"
    />

    <!-- 顶部中央裂口：银杏叶标志性二裂感，不要太深 -->
    <path
      d="M109.1 44.1C111.9 52.2 113.2 60.8 112.6 69.8C112.2 76.4 110.9 82.6 108.7 89.4"
      stroke-width="2.1"
      opacity="0.9"
    />

    <!-- 左侧轮廓的内层装饰线，让叶片更有参考图的细腻感 -->
    <path
      d="
        M109.6 137.8
        C94.8 132.6 80.7 126.2 68.9 117.4
        C56.8 108.4 48.6 97.7 44.9 85.9
        C41.4 74.8 42.7 63.6 48.6 54.4
        C54.9 44.7 65 39.1 76.8 38.2
      "
      stroke-width="1.55"
      opacity="0.44"
    />

    <!-- 右侧轮廓的内层装饰线 -->
    <path
      d="
        M110.8 137.8
        C126.5 132.5 141.1 126 153.3 116.9
        C165.3 107.9 173.3 97.1 176.7 85.2
        C179.8 74.2 178.2 63.1 172.3 54.1
        C166 44.5 155.9 39 144.2 38.2
      "
      stroke-width="1.55"
      opacity="0.44"
    />

    <!-- 主叶脉：从叶柄收窄处向外放射，左侧 -->
    <path d="M110.2 143.6C94.5 130.8 78.6 120.5 56.2 108.4" stroke-width="2.15" opacity="0.9" />
    <path d="M110.2 143.6C91.8 126.2 73.2 109.4 46.8 87.2" stroke-width="2.05" opacity="0.88" />
    <path d="M110.2 143.6C91.9 120.7 75.2 99.5 54.2 67.1" stroke-width="1.92" opacity="0.86" />
    <path d="M110.2 143.6C95.6 117.6 83.6 91.9 73.1 54.8" stroke-width="1.82" opacity="0.84" />
