    <path d="M110.2 143.6C124 131.5 136.5 121.4 151.4 111.1" stroke-width="1.32" opacity="0.72" />
    <path d="M110.2 143.6C125.1 128.3 138.1 114.4 154.1 97.8" stroke-width="1.28" opacity="0.7" />
    <path d="M110.2 143.6C124.7 124.8 137.5 107.1 152.5 84.9" stroke-width="1.24" opacity="0.7" />
    <path d="M110.2 143.6C122.7 122.2 133.7 101.2 145.8 74.2" stroke-width="1.2" opacity="0.68" />
    <path d="M110.2 143.6C120 119.8 127.7 97.5 134.8 68.7" stroke-width="1.16" opacity="0.68" />
