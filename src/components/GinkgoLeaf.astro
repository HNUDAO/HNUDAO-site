    <path d="M110.2 143.6C129.1 125.8 148.2 108.4 174.7 85.2" stroke-width="2.05" opacity="0.88" />
    <path d="M110.2 143.6C128.8 120.1 145.6 98.1 166.2 65.2" stroke-width="1.92" opacity="0.86" />
    <path d="M110.2 143.6C125.3 117.1 137.6 90.8 148.5 52.9" stroke-width="1.82" opacity="0.84" />
