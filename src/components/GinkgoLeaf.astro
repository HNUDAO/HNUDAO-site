    <!-- 边缘方向短线：强化顶部扇形与波浪边缘 -->
    <path d="M110.2 143.6C86.2 137.9 66.2 132.3 49.7 124.4" stroke-width="1.1" opacity="0.58" />
    <path d="M110.2 143.6C134.8 137.7 155.3 131.8 171.8 123.4" stroke-width="1.1" opacity="0.58" />
