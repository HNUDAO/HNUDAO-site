---
import Leaf1 from "@/components/GinkgoLeaf/Leaf1.astro";
import Leaf2 from "@/components/GinkgoLeaf/Leaf2.astro";
import Leaf3 from "@/components/GinkgoLeaf/Leaf3.astro";
import Leaf4 from "@/components/GinkgoLeaf/Leaf4.astro";

type Props = {
  class?: string;
  variant?: "leaf1" | "leaf2" | "leaf3" | "leaf4";
};

const { class: className = "", variant = "leaf3" } = Astro.props;

const variants = {
  leaf1: Leaf1,
  leaf2: Leaf2,
  leaf3: Leaf3,
  leaf4: Leaf4,
};

const LeafComponent = variants[variant];
---

<LeafComponent class={className} />
