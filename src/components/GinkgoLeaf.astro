---
type Props = {
  class?: string;
};

const { class: className = "" } = Astro.props;
---

<svg
  aria-hidden="true"
  class={className}
  fill="none"
  viewBox="0 0 220 220"
  xmlns="http://www.w3.org/2000/svg"
>
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- 细长叶柄：参考图里叶柄较长、轻微弯曲 -->
    <path
      d="M110.8 204C109.9 188.5 109.8 175.2 112.2 162.7C113.9 153.8 114.2 148.4 110.2 143.6"
      stroke-width="4.2"
    />

    <!-- 银杏叶外轮廓：扇形、上缘自然起伏、中央浅裂口、下方收窄 -->
    <path
      d="
        M110.2 143.6
        C99.1 139.4 87.4 135.5 75.8 129.4
        C62.6 122.5 50.9 112.8 43.2 100.8
        C36.1 89.8 32.8 77.1 34.8 65.1
        C36.7 53.7 43.5 43.4 54.1 36.8
        C63.4 31 74.7 28.6 86.1 30.1
        C95.8 31.4 103.8 36.4 109.1 44.1

        C112.2 36.1 119.8 30.7 129.4 28.9
        C140.7 26.8 152.5 29.1 162.7 35.4
        C173.3 41.9 180.3 52.1 182.4 63.8
