---
import { formatDate } from "@/lib/formatDate";
import { isExternalHref } from "@/lib/content";
import { getLocaleFromPath, useTranslations } from "@/lib/i18n";
import Tag from "./Tag.astro";

type Props = {
  href: string;
  title: string;
  description: string;
  startDate: Date | string;
  location?: string;
  status: "upcoming" | "ongoing" | "past";
  category?: string;
  tags?: string[];
  cover?: string;
  compact?: boolean;
};

const {
  href,
  title,
  description,
  startDate,
  location,
  status,
  category,
  tags = [],
  cover,
  compact = false,
} = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);

const statusMap = {
  upcoming: {
    label: t("activities.upcoming"),
    wrap: "border-jade-200 bg-jade-100/80 text-jade-700",
    dot: "bg-jade-500",
  },
  ongoing: {
    label: t("activities.ongoing"),
    wrap: "border-gold-300 bg-gold-100/80 text-amber-700",
    dot: "bg-gold-500",
  },
  past: {
    label: t("activities.past"),
    wrap: "border-ink-200 bg-ink-100 text-ink-700",
    dot: "bg-ink-500",
  },
}[status];

const isExternal = isExternalHref(href);
---

<article class:list={["surface-card group flex flex-col overflow-hidden", compact && "surface-card-compact"]} data-reveal>
  <a
    class="focus-ring flex h-full flex-col"
    href={href}
    rel={isExternal ? "noreferrer" : undefined}
    target={isExternal ? "_blank" : undefined}
  >
    <div class:list={["overflow-hidden bg-ink-100", compact ? "aspect-[16/7.2]" : "aspect-[16/9]"]}>
      <img
        alt={`${title} cover`}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
        height="360"
        loading="lazy"
        src={cover || "/images/placeholder-cover.svg"}
        width="640"
        decoding="async"
      />
    </div>
    <div class:list={["flex h-full flex-col", compact ? "px-3.5 py-3.5" : "px-4 py-4 sm:px-5 sm:py-5"]}>
      <div class="flex flex-wrap items-center gap-2.5">
        <span class={`status-pill ${statusMap.wrap}`}>
          <span class={`status-dot ${statusMap.dot}`}></span>
          {statusMap.label}
        </span>
        {category && <Tag label={category} variant="accent" />}
      </div>
      <h3
        class:list={[
          "mt-2.5 font-semibold tracking-tight text-ink-950 transition group-hover:text-signal-500",
          compact ? "text-[1.08rem] leading-6" : "text-[1.25rem] leading-7 sm:text-[1.45rem]",
        ]}
      >
        {title}
      </h3>
      <p class:list={["mt-2 text-ink-600", compact ? "text-[0.82rem] leading-5" : "text-[0.86rem] leading-6"]}>
        {description}
      </p>
      <div class:list={["mt-3.5 grid text-ink-500", compact ? "gap-1 text-[0.7rem]" : "gap-1 text-[0.82rem]"]}>
        <p>{t("activities.time")}：{formatDate(startDate, locale)}</p>
        <p>{t("activities.location")}：{location || t("activities.locationTba")}</p>
      </div>
      {tags.length > 0 && (
        <div class="mt-3.5 flex flex-wrap gap-1.5">
          {tags.slice(0, compact ? 2 : 3).map((tag) => <Tag label={tag} />)}
        </div>
      )}
      <div class="mt-auto pt-4 text-[0.84rem] font-medium text-signal-500">
        {isExternal ? t("common.viewLink") : t("activities.viewActivity")}
      </div>
    </div>
  </a>
</article>
