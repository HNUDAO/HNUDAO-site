---
import type { TimelineItem } from "@/data/timeline";

type Props = {
  items: TimelineItem[];
};

const { items } = Astro.props;
---

<ol class="relative border-l border-ink-200 pl-8" data-reveal>
  {items.map((item) => (
    <li class="relative pb-10 last:pb-0">
      <span class="absolute -left-[2.18rem] top-1 flex h-6 w-6 items-center justify-center rounded-full border border-jade-200 bg-white text-xs font-semibold text-jade-700">
        ●
      </span>
      <p class="subtle-label">{item.year}</p>
      <h3 class="mt-3 text-2xl font-semibold text-ink-950">{item.title}</h3>
      <p class="mt-3 max-w-3xl text-base leading-8 text-ink-600">{item.description}</p>
    </li>
  ))}
</ol>
