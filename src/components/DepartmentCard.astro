---
import type { Department } from "@/data/departments";
import Tag from "./Tag.astro";

type Props = {
  department: Department;
};

const { department } = Astro.props;
---

<article class="surface-card flex h-full flex-col px-5 py-5" data-reveal>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="subtle-label">Department</p>
      <h3 class="mt-2.5 text-[1.35rem] font-semibold text-ink-950">{department.name}</h3>
    </div>
    <div class="rounded-[1rem] bg-ink-100 px-3 py-2.5 text-right">
      <p class="text-xs uppercase tracking-[0.2em] text-ink-500">成员规模</p>
      <p class="mt-2 text-sm font-semibold text-ink-800">{department.membersCount}</p>
    </div>
  </div>
  <p class="mt-4 text-[0.92rem] leading-6 text-ink-600">{department.description}</p>
  <div class="mt-5">
    <p class="text-sm font-semibold text-ink-900">核心职责</p>
    <ul class="mt-3 space-y-1.5 text-[0.84rem] leading-6 text-ink-600">
      {department.responsibilities.map((item) => (
        <li class="flex gap-3">
          <span aria-hidden="true" class="mt-2 h-2 w-2 rounded-full bg-jade-500"></span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="mt-5 flex flex-wrap gap-1.5">
    {department.tags.map((tag) => <Tag label={tag} />)}
  </div>
  <div class="mt-5 grid gap-2.5 rounded-[1rem] bg-ink-50 px-3.5 py-3.5 text-[0.82rem] text-ink-600 sm:grid-cols-2">
    <p><span class="font-semibold text-ink-900">负责人：</span>{department.lead}</p>
    <p><span class="font-semibold text-ink-900">联系：</span>{department.contact}</p>
  </div>
</article>
