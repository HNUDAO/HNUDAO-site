---
import Footer from "@/components/Footer.astro";
import GinkgoLeaf from "@/components/GinkgoLeaf.astro";
import Header from "@/components/Header.astro";
import { ClientRouter } from "astro:transitions";
import { defaultOgImage, siteDescription, siteName, siteUrl } from "@/lib/site";
import { getLocaleFromPath, useTranslations } from "@/lib/i18n";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
};

const locale = getLocaleFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const { title, description = siteDescription[locale], image = defaultOgImage, noindex = false } = Astro.props;

const zhPath = Astro.url.pathname.replace(/^\/en/, "") || "/";
const enPath = `/en${Astro.url.pathname.replace(/^\/en/, "")}`;
const canonical = new URL(Astro.url.pathname, siteUrl).toString();

const pageTitle = title ? `${title} | ${siteName}` : siteName;
const imageUrl = new URL(image, siteUrl).toString();
const isHome = /^\/(en\/)?$/.test(Astro.url.pathname);
---

<!doctype html>
<html lang={locale === "en" ? "en" : "zh-CN"}>
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content="light dark" name="color-scheme" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("hnudao-theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (theme === "dark" || (theme !== "light" && prefersDark)) {
          document.documentElement.classList.add("dark");
        }
        if (theme === "light") {
          document.documentElement.classList.add("light");
        }
      } catch {}
    </script>
    <title>{pageTitle}</title>
    <meta content={description} name="description" />
    <meta content={siteName} property="og:site_name" />
    <meta content={pageTitle} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content="website" property="og:type" />
    <meta content={canonical} property="og:url" />
    <meta content={imageUrl} property="og:image" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={pageTitle} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={imageUrl} name="twitter:image" />
    <link href={canonical} rel="canonical" />
    <link rel="alternate" hreflang="zh-CN" href={new URL(zhPath, siteUrl).toString()} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, siteUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(zhPath, siteUrl).toString()} />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <ClientRouter />
    {noindex && <meta content="noindex, nofollow" name="robots" />}
  </head>
  <body class:list={["min-h-screen", isHome && "home-page"]}>
    <a class="skip-link" href="#main-content">{t("common.skipToContent")}</a>
    <div aria-hidden="true" class="site-ginkgo site-ginkgo-left">
      <GinkgoLeaf class="site-ginkgo-icon" variant="leaf3" />
    </div>
    <div aria-hidden="true" class="site-ginkgo site-ginkgo-upper-right">
      <GinkgoLeaf class="site-ginkgo-icon" variant="leaf1" />
    </div>
    <div aria-hidden="true" class="site-ginkgo site-ginkgo-right">
      <GinkgoLeaf class="site-ginkgo-icon" variant="leaf3" />
    </div>
    <div aria-hidden="true" class="site-ginkgo site-ginkgo-mid-left">
      <GinkgoLeaf class="site-ginkgo-icon" variant="leaf2" />
    </div>
    <div aria-hidden="true" class="site-ginkgo site-ginkgo-bottom">
      <GinkgoLeaf class="site-ginkgo-icon" variant="leaf4" />
    </div>
    <Header />
    <slot />
    <Footer />

    <script>
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const clamp = (value: number, min: number, max: number) => Math.min(Math.max(value, min), max);
      const easeOutCubic = (value: number) => 1 - Math.pow(1 - value, 3);
      const easeInOutCubic = (value: number) =>
        value < 0.5 ? 4 * value * value * value : 1 - Math.pow(-2 * value + 2, 3) / 2;

      const setDefaultHeaderState = (header: Element | null) => {
        if (!(header instanceof HTMLElement)) return;
        header.style.setProperty("--header-line-opacity", "0.28");
        header.style.setProperty("--header-top-opacity", "0.34");
        header.style.setProperty("--header-bottom-opacity", "0.22");
        header.style.setProperty("--header-highlight-opacity", "0.44");
        header.style.setProperty("--header-shadow-opacity", "0.12");
        header.style.setProperty("--header-sheen-opacity", "0.62");
      };

      let cleanup = () => {};

      const init = () => {
        cleanup();
        const controller = new AbortController();
        const { signal } = controller;
        let observer: IntersectionObserver | undefined;
        cleanup = () => {
          controller.abort();
          observer?.disconnect();
        };

        const header = document.querySelector("[data-site-header]");
        const coverShell = document.querySelector("[data-home-cover-shell]");
        const cover = document.querySelector("[data-home-cover]");
        const logoStage = document.querySelector("[data-home-logo-stage]");
        const homeContent = document.querySelector("[data-home-content]");
        const indicator = document.querySelector("[data-home-scroll-indicator]");

        const hasHomeHero =
          coverShell instanceof HTMLElement &&
          cover instanceof HTMLElement &&
          logoStage instanceof HTMLElement &&
          homeContent instanceof HTMLElement;

        document.body.classList.toggle("home-scroll-transition", hasHomeHero);

        const revealItems = document.querySelectorAll("[data-reveal]");
        if (prefersReducedMotion) {
          revealItems.forEach((item) => item.classList.add("is-visible"));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.16, rootMargin: "0px 0px -48px 0px" },
          );
          observer = io;
          revealItems.forEach((item) => io.observe(item));
        }

        const setIndicator = (progress: number) => {
          if (!(indicator instanceof HTMLElement)) return;
          const eased = prefersReducedMotion ? 0 : easeOutCubic(progress);
          indicator.style.setProperty("--scroll-indicator-opacity", String(1 - eased));
          indicator.style.setProperty("--scroll-indicator-translate", `${eased * 24}px`);
          indicator.style.visibility = progress >= 1 ? "hidden" : "visible";
        };

        if (!hasHomeHero) {
          setDefaultHeaderState(header);
          setIndicator(1);
          return;
        }

        if (prefersReducedMotion) {
          setDefaultHeaderState(header);
          const onScroll = () => setIndicator(clamp(window.scrollY / 40, 0, 1));
          onScroll();
          window.addEventListener("scroll", onScroll, { passive: true, signal });
          return;
        }

        let ticking = false;
        let lastLocal = -1;

        const update = (force = false) => {
          const shellTop = coverShell.offsetTop;
          const viewportHeight = window.innerHeight;
          const range = viewportHeight * 1.1;
          const localScroll = clamp(window.scrollY - shellTop, 0, range);

          if (!force && localScroll === lastLocal) return;
          lastLocal = localScroll;

          const logoProgress = clamp(localScroll / (viewportHeight * 0.74), 0, 1);
          const contentProgress = clamp(
            (localScroll - viewportHeight * 0.08) / (viewportHeight * 0.62),
            0,
            1,
          );
          const headerProgress = clamp(
            (localScroll - viewportHeight * 0.04) / (viewportHeight * 0.28),
            0,
            1,
          );

          const logoEase = easeInOutCubic(logoProgress);
          const contentEase = easeOutCubic(contentProgress);
          const headerEase = easeOutCubic(headerProgress);

          logoStage.style.setProperty("--logo-opacity", String(clamp(1 - logoEase * 1.15, 0, 1)));
          logoStage.style.setProperty("--logo-scale", String(1 - logoEase * 0.42));
          logoStage.style.setProperty("--logo-translate", `${logoEase * -72}px`);

          homeContent.style.setProperty("--content-opacity", String(contentEase));
          homeContent.style.setProperty("--content-translate", `${(1 - contentEase) * 160}px`);

          if (header instanceof HTMLElement) {
            header.style.setProperty("--header-line-opacity", String(headerEase * 0.44));
            header.style.setProperty("--header-top-opacity", String(0.04 + headerEase * 0.36));
            header.style.setProperty("--header-bottom-opacity", String(0.02 + headerEase * 0.26));
            header.style.setProperty("--header-highlight-opacity", String(0.12 + headerEase * 0.34));
            header.style.setProperty("--header-shadow-opacity", String(0.01 + headerEase * 0.16));
            header.style.setProperty("--header-sheen-opacity", String(0.18 + headerEase * 0.48));
          }

          setIndicator(clamp(localScroll / 90, 0, 1));
        };

        const onScroll = () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(() => {
              ticking = false;
              update();
            });
          }
        };

        const onResize = () => update(true);

        update(true);
        window.addEventListener("scroll", onScroll, { passive: true, signal });
        window.addEventListener("resize", onResize, { signal });
      };

      let booted = false;
      document.addEventListener("astro:page-load", () => {
        if (!booted) {
          booted = true;
          init();
        }
      });
      document.addEventListener("astro:after-swap", () => {
        booted = true;
        init();
      });
      document.addEventListener("astro:before-swap", () => {
        document.documentElement.style.scrollBehavior = "auto";
      });
      document.addEventListener("astro:page-load", () => {
        document.documentElement.style.scrollBehavior = "";
      });
    </script>
  </body>
</html>
